<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".SeachBusActivity"
    android:background="#EEEDF3"
    >


    <View
        android:id="@+id/box1"
        android:layout_width="match_parent"
        android:layout_height="360dp"
        android:background="#C1A4F4"
        />

    <ImageView
        android:id="@+id/icon1"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:background="@drawable/baseline_more_horiz"
        android:layout_marginLeft="30dp"

        />

    <ImageView
        android:layout_marginRight="30dp"
        android:id="@+id/icon2"
        android:layout_width="40dp"
        android:layout_marginTop="20dp"
        android:layout_height="40dp"
        android:background="@drawable/baseline_person"
        android:layout_alignParentEnd="true"/>
    
    <TextView
        android:id="@+id/text1"
        android:layout_below="@id/icon1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hi, Jhon"
        android:textSize="15sp"
        android:layout_marginTop="60dp"
        android:layout_marginLeft="60dp"
        />


    <TextView
        android:id="@+id/text2"
        android:layout_below="@id/text1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bus"
        android:textSize="67sp"
        android:layout_marginLeft="60dp"
        android:textColor="@color/white"
        android:textStyle="bold"
        />

    <View
        android:id="@+id/box2"
        android:layout_below="@id/text2"
        android:layout_width="350dp"
        android:layout_height="200dp"
        android:background="@color/white"
        android:layout_marginTop="30dp"
        android:layout_centerHorizontal="true"

        />
        <ImageView
            android:id="@+id/icon3"
            android:layout_below="@id/text2"
            android:layout_marginTop="60dp"
            android:layout_marginLeft="67dp"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="#2c2c2c"
            android:src="@drawable/baseline_local_airport"
            />
        <TextView
            android:id="@id/text3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="From"
            android:layout_below="@id/text2"
            android:layout_toRightOf="@id/icon3"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="56dp"
            />
    <TextView
        android:id="@+id/text4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Location 1"
        android:layout_below="@id/text3"
        android:layout_toRightOf="@id/icon3"
        android:layout_marginLeft="10dp"
        android:textSize="21dp"
        />

        <ImageView
            android:id="@+id/icon5"
            android:layout_below="@id/text4"
            android:layout_toRightOf="@id/text4"
            android:layout_marginLeft="90dp"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:background="#2c2c2c"
            android:src="@drawable/baseline_compare_arrows"/>
    <ImageView
        android:id="@+id/icon4"
        android:layout_below="@id/icon3"
        android:layout_marginTop="60dp"
        android:layout_marginLeft="67dp"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:background="#2c2c2c"
        android:src="@drawable/baseline_location_on"
        />
    <TextView
        android:id="@id/text5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="To"
        android:layout_below="@id/text4"
        android:layout_toRightOf="@id/icon3"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="45dp"
        />
    <TextView
        android:id="@+id/text6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Location 2"
        android:layout_below="@id/text5"
        android:layout_toRightOf="@id/icon3"
        android:layout_marginLeft="10dp"
        android:textSize="21dp"
        />

    <View
        android:id="@+id/box3"
        android:layout_below="@id/box1"
        android:layout_width="350dp"
        android:layout_height="200dp"
        android:background="@color/white"
        android:layout_marginTop="150dp"
        android:layout_centerHorizontal="true"
        />

    <ImageView
        android:id="@+id/icon6"
        android:layout_below="@id/text6"
        android:layout_marginTop="102dp"
        android:layout_marginLeft="67dp"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:background="#2c2c2c"
        />
    <TextView
        android:id="@+id/text7"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PASSENGER"
        android:layout_below="@id/text6"
        android:layout_toRightOf="@id/icon6"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="100dp"
        />
    <TextView
        android:id="@+id/text8"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TYPE"
        android:layout_below="@id/text6"
        android:layout_toRightOf="@id/text7"
        android:layout_marginLeft="90dp"
        android:layout_marginTop="100dp"
        />
    <ImageView
        android:id="@+id/icon7"
        android:layout_below="@id/text7"
        android:layout_toRightOf="@id/icon6"
        android:layout_width="10dp"
        android:layout_marginLeft="15dp"
        android:layout_height="10dp"
        android:background="#2c2c2c"
        android:layout_marginTop="10dp"
        android:src="@drawable/baseline_horizontal_rule"
        />
    <TextView
        android:id="@+id/text9"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="01"
        android:textSize="20sp"
        android:layout_below="@id/text7"
        android:layout_toRightOf="@id/icon7"
        android:layout_marginLeft="10dp"
        />
    <ImageView
        android:id="@+id/icon8"
        android:layout_below="@id/text7"
        android:layout_toRightOf="@id/text9"
        android:layout_width="10dp"
        android:layout_marginLeft="10dp"
        android:layout_height="10dp"
        android:background="#2c2c2c"
        android:layout_marginTop="10dp"
        android:src="@drawable/baseline_add"
        />
    <TextView
        android:id="@+id/text10"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TYPE"
        android:textSize="23sp"
        android:layout_below="@id/text8"
        android:layout_toRightOf="@id/text7"
        android:layout_marginLeft="90dp"

        />
    <ImageView
        android:id="@+id/icon9"
        android:layout_below="@id/icon6"
        android:layout_marginTop="72dp"
        android:layout_marginLeft="67dp"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:background="#2c2c2c"
        />
    <TextView
        android:id="@+id/text11"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DEPART"
        android:layout_below="@id/text10"
        android:layout_toRightOf="@id/icon6"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="52dp"
        />
    <TextView
        android:id="@+id/text12"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sun 3 Jun 2021"
        android:layout_below="@id/text11"
        android:layout_toRightOf="@id/icon6"
        android:layout_marginLeft="10dp"
        android:textSize="20sp"
    />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button2"
        android:layout_width="200dp"
        android:layout_height="80dp"
        android:layout_below="@id/box3"
        android:layout_marginTop="30dp"
        android:layout_centerHorizontal="true"
        android:backgroundTint="@color/white"
        android:hint="Create"
        android:textColorHint="#C3A8F7" />

    <View
        android:id="@+id/box4"
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:layout_alignParentBottom="true"
        android:background="@color/white"
        android:layout_centerHorizontal="true"
        />


    <ImageView
            android:id="@+id/icon10"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="35dp"
            android:layout_width="50dp"
            android:layout_marginLeft="40dp"
            android:layout_height="50dp"
            android:background="#2c2c2c"
        android:src="@drawable/baseline_home"
        />
    <ImageView
        android:id="@+id/icon11"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="35dp"
        android:layout_toRightOf="@id/icon10"
        android:layout_width="50dp"
        android:layout_marginLeft="50dp"
        android:layout_height="50dp"
        android:background="#2c2c2c"
        android:src="@drawable/baseline_access_time_filled"
        />
    <ImageView
        android:id="@+id/icon12"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="35dp"
        android:layout_toRightOf="@id/icon11"
        android:layout_width="50dp"
        android:layout_marginLeft="50dp"
        android:layout_height="50dp"
        android:background="#2c2c2c"
        android:src="@drawable/baseline_access_time_filled"
        />
    <ImageView
        android:id="@+id/icon13"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="35dp"
        android:layout_toRightOf="@id/icon12"
        android:layout_width="50dp"
        android:layout_marginLeft="50dp"
        android:layout_height="50dp"
        android:background="#2c2c2c"
        android:src="@drawable/baseline_person"
        />

</RelativeLayout>